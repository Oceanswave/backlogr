# Copy to ~/backlogr/.env (chmod 600). Never commit the real file.
BACKLOGR_TOKEN=<long random secret, e.g. from: python3 -c "import secrets;print(secrets.token_urlsafe(32))">
BACKLOGR_DB=/home/<user>/backlogr/data/backlogr.db
BACKLOGR_PORT=8796
# Bind IPs, comma separated. Never 0.0.0.0 unless behind an authenticating proxy.
BACKLOGR_HOSTS=127.0.0.1
# Host header names your proxy sends (e.g. your-host.your-tailnet.ts.net).
BACKLOGR_ALLOWED_HOSTS=<your-host.your-tailnet.ts.net>
BACKLOGR_BACKUP_DIR=/home/<user>/backlogr/backups
BACKLOGR_BACKUP_KEEP=14
BACKLOGR_EXPORT=/home/<user>/backlogr/exports/backlogr-export.json

# Name in messages and default person for act; configure CLI clients too.
BACKLOGR_OWNER=owner
