[Unit]
Description=Backlogr (MCP + JSON API, system of record for bot work)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=%h/backlogr
EnvironmentFile=%h/backlogr/.env
ExecStart=%h/backlogr/.venv/bin/backlogr-server
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
